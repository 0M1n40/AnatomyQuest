   "children": [
    {
     "label": "MHC / HLA",
     "figures": [
      "imu-mhc"
     ],
     "children": [
      {
       "label": "Cromossomo 6; codominante e polimórfico"
      },
      {
       "label": "MHC I: todas as nucleadas → CD8+ (endógeno, 8–11 aa)"
      },
      {
       "label": "MHC II: APCs → CD4+ (exógeno, fenda aberta)"
      },
      {
       "label": "Interferons aumentam o MHC"
      }
     ]
    },
    {
     "label": "Processamento",
     "children": [
      {
       "label": "Via citosólica: proteassomo → TAP → RE → MHC I"
      },
      {
       "label": "Via endossômica: catepsinas, cadeia invariante, CLIP, HLA-DM"
      },
      {
       "label": "Apresentação cruzada: dendríticas → MHC I → CD8+"
      }
     ]
    },
    {
     "label": "Ativação T – 3 sinais",
     "figures": [
      "imu-ativacao"
     ],
     "children": [
      {
       "label": "1º: TCR + MHC-peptídeo (CD4/CD8)"
      },
      {
       "label": "2º: B7 (CD80/86) – CD28"
      },
      {
       "label": "Sem 2º sinal → anergia/tolerância"
      },
      {
       "label": "3º: citocinas → Th1, Th2, Th17, Treg"
      }
     ]
    },
    {
     "label": "Receptores",
     "children": [
      {
       "label": "BCR: anticorpo de membrana, antígeno nativo"
      },
      {
       "label": "TCR + CD3: só peptídeo no MHC (restrição)"
      }
     ]
    }
